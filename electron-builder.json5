{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "com.m3u8helper.app",
  "productName": "m3u8-helper",
  "directories": {
    "buildResources": "resources",
    "output": "dist"
  },
  "files": [
    "out/**/*",
    "resources/**/*"
  ],
  // 命令行工具按需携带：仓库根目录存在对应 exe 时才会打入 resources/bin，缺失则跳过
  "extraResources": [
    {
      "from": ".",
      "to": "bin",
      "filter": [
        "N_m3u8DL-RE.exe",
        "ffmpeg.exe"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icon.ico",
    "sign": false,
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
